# Direct Postgres connection used by the scripts in scripts/ (db:types, db:apply,
# db:dump). Supabase Dashboard -> Project Settings -> Database -> Connection string
# -> "Session pooler". Copy this file to .env.local and fill in the password.
SUPABASE_DB_URL=postgresql://postgres.<project-ref>:<db-password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# Browser client (publishable, safe to expose). Defaults are baked into
# src/integrations/supabase/client.ts, so these are optional overrides.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
